<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ar.edu.uns.cei</groupId>
    <artifactId>minijava-compilador</artifactId>
    <version>0.1.0-etapa1</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.14.1</junit.version>
        <jqwik.version>1.9.1</jqwik.version>
        <!-- Volcado a consola de la salida del compilador por cada caso del corpus:
             completo (default) | resumen | off. Ver VolcadoDeCasos. -->
        <volcado>completo</volcado>
        <!-- Logros con los que corre la suite: ninguno | todos | etapaN | a,b,c.
             Vacío = todos. Ver ConfiguracionDeLaCorrida y @RequiereLogro. -->
        <!-- Etiquetas JUnit a correr; lo fijan los perfiles fase-*. -->
        <fases/>
        <!-- Umbrales del perfil `mutacion`. Se bajan sólo con -D cuando hace falta
             mirar un informe parcial; el valor versionado es el que se sostiene. -->
        <umbral.mutacion>88</umbral.mutacion>
        <umbral.cobertura.pit>95</umbral.cobertura.pit>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.vintage</groupId>
            <artifactId>junit-vintage-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <version>${jqwik.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Pautas Etapa 1: el compilador debe poder invocarse como
             `java -jar Compilador.jar programa1.java`. Sin esto el artefacto
             sale como minijava-compilador-<version>.jar. -->
        <finalName>Compilador</finalName>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- Explícito y no confiando en la propagación implícita de -D
                         al JVM forkeado: es un interruptor que se usa a mano. -->
                    <systemPropertyVariables>
                        <volcado>${volcado}</volcado>
                    </systemPropertyVariables>
                    <!-- Vacío por defecto: sin -Pfase-* corre la suite entera. -->
                    <groups>${fases}</groups>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>minijava.aplicacion.Main</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <configuration>
                    <!-- SourceManagerImpl es la implementación de referencia de la
                         cátedra: se conserva intacta y el compilador no la usa, así
                         que no tiene sentido que cuente para la cobertura. -->
                    <excludes>
                        <exclude>minijava/comun/io/SourceManagerImpl.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <!-- mvn verify falla si la cobertura baja de estos umbrales.
                             Van un punto por debajo de la cobertura real (98,9% de
                             líneas y 94,4% de ramas) para no romper con cualquier
                             variación menor. Lo que queda sin cubrir son los `else`
                             del Esquema Simple que el chequeo del llamador ya hace
                             inalcanzables, y que igual se escriben porque la slide 36
                             los pide. -->
                        <id>jacoco-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.98</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.93</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Cada etapa se corrige por separado, así que su suite tiene que poder
             correrse sola. Los tests de comun/ van en las dos: son el piso de
             las dos fases. -->
        <profile>
            <id>fase-lexico</id>
            <properties>
                <fases>lexico,comun</fases>
            </properties>
        </profile>

        <profile>
            <id>fase-sintactico</id>
            <properties>
                <fases>sintactico,comun</fases>
            </properties>
        </profile>

        <profile>
            <id>mutacion</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>1.25.9</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>1.2.3</version>
                            </dependency>
                        </dependencies>
                        <!-- Sin esto el goal no se ata a ninguna fase y
                             `mvn -Pmutacion verify` corre la suite sin mutar nada. -->
                        <executions>
                            <execution>
                                <id>pitest-mutacion</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>mutationCoverage</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <targetClasses>
                                <param>minijava.*</param>
                            </targetClasses>
                            <!-- Los tests dirigidos, que corren en segundos. Los
                                 runners del corpus y las propiedades quedan afuera:
                                 son excelentes para verificar pero pésimos para mutar,
                                 porque cada mutante volvería a correr miles de casos
                                 parametrizados o cientos de intentos de jqwik. -->
                            <targetTests>
                                <param>minijava.sintactico.*Test</param>
                                <param>minijava.sintactico.*.*Test</param>
                                <param>minijava.lexico.AnalizadorLexico*Test</param>
                                <param>minijava.lexico.*Test</param>
                                <param>minijava.comun.*.*Test</param>
                                <param>minijava.aplicacion.*Test</param>
                            </targetTests>
                            <!-- La implementación de referencia de la cátedra no se
                                 testea ni se usa: mutarla sólo produce ruido. -->
                            <excludedClasses>
                                <param>minijava.comun.io.SourceManagerImpl</param>
                            </excludedClasses>
                            <!-- Los runners del corpus y las propiedades quedan afuera
                                 de la caza de mutantes: son excelentes para verificar
                                 pero pésimos para mutar, porque cada mutante volvería a
                                 correr miles de casos parametrizados o cientos de
                                 intentos de jqwik. Matan lo mismo los tests dirigidos,
                                 y en segundos en vez de horas. -->
                            <excludedTestClasses>
                                <param>minijava.lexico.*PropiedadesTest</param>
                                <param>minijava.lexico.*FuzzTest</param>
                                <param>minijava.sintactico.*PropiedadesTest</param>
                            </excludedTestClasses>
                            <jvmArgs>
                                <jvmArg>-Xmx2g</jvmArg>
                            </jvmArgs>
                            <!-- Un mutante que sobrevive es una línea que ningún test
                                 distingue de otra cosa. El umbral hace que eso falle el
                                 build en vez de quedar en un informe que nadie mira. -->
                            <mutationThreshold>${umbral.mutacion}</mutationThreshold>
                            <coverageThreshold>${umbral.cobertura.pit}</coverageThreshold>
                            <timeoutConstant>6000</timeoutConstant>
                            <threads>4</threads>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
