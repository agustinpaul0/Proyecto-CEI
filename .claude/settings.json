{
  "permissions": {
    "allow": [
      "Bash(mvn test:*)",
      "Bash(mvn verify:*)",
      "Bash(mvn package:*)",
      "Bash(mvn compile:*)",
      "Bash(mvn -q test:*)",
      "Bash(mvn -q -o compile:*)",
      "Bash(mvn -Pmutacion test:*)",
      "Bash(java -jar target/Compilador.jar:*)",
      "Bash(python3 herramientas/generar_casos.py:*)",
      "Bash(python3 herramientas/lote1.py:*)",
      "Bash(python3 herramientas/lote2.py:*)",
      "Bash(python3 herramientas/lote3.py:*)",
      "Bash(python3 herramientas/lote4.py:*)",
      "Bash(python3 herramientas/lote5.py:*)",
      "Bash(python3 herramientas/lote6.py:*)",
      "Bash(python3 herramientas/lote7.py:*)",
      "Bash(latexmk -pdf:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/suite-al-cerrar.sh\""
          }
        ]
      }
    ]
  }
}
